# ENTWURF. Stundenpruefung: Exit 8 (und damit OnFailure-Alarm), wenn der Runner keine frische Kerze mehr liefert,
# die Datenbank nicht lesbar ist oder die Konfiguration abgelehnt wird. Nur lesender Zugriff, kein Netz, kein Port.
[Unit]
Description=CT109 paper runner freshness watch (read-only, alarms via OnFailure)
OnFailure=signal-unit-failed@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ct109-paper
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m lf1 paper-status --config /opt/ct109-paper/runner_config.json --max-age-s 7800
DynamicUser=yes
User=ct109-paper
StateDirectory=ct109-paper
StateDirectoryMode=0755
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
Nice=15
CPUQuota=10%
MemoryMax=150M
TimeoutStartSec=60
